{
  "name": "dcbot",
  "version": "1.0.0",
  "description": "Discord bot with moderation, utility, economy, music, ticketing, and auto-reconnect support.",
  "main": "src/index.js",
  "scripts": {
    "start": "pm2 startOrReload ecosystem.config.js --only dcbot",
    "say": "node src/index.js --say",
    "stop": "pm2 stop dcbot && pm2 delete dcbot",
    "restart": "pm2 restart dcbot",
    "deploy": "node src/deploy-commands.js"
  },
  "engines": {
    "node": "^25.0.0"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "discord-api-types": "^0.37.62",
    "discord.js": "^14.14.0",
    "distube": "^5.2.3",
    "dotenv": "^16.0.3",
    "ffmpeg-static": "^5.3.0",
    "ms": "^2.1.3",
    "pm2": "^5.3.1"
  }
}
