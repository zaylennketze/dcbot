[Unit]
Description=dcbot Discord bot
After=network.target

[Service]
Type=simple
# Set this to the user that should run the bot, or leave as a placeholder
User=%USER%
WorkingDirectory=%REPO_PATH%
ExecStart=/usr/bin/node %REPO_PATH%/start-supervisor.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Uncomment and set environment variables here if needed
# Environment=BOT_TOKEN=your_token_here

[Install]
WantedBy=multi-user.target
